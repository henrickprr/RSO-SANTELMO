# Exemplo de configuração. Não coloque senhas reais no GitHub.
# No Render, preencha as variáveis no painel Environment.
# No computador, use: python -m uvicorn web:create_app --factory --env-file .env --port 8550
RSO_USERNAME=admin
# Troque por uma senha própria de pelo menos 12 caracteres.
RSO_PASSWORD=
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLET_SECRET_KEY=
# Local: ./dados-rso. Render Free: /tmp/rso-data (temporário).
RSO_DATA_DIR=./dados-rso
# ephemeral exibe o lembrete de backup na interface. Use local no computador.
RSO_STORAGE_MODE=local
TZ=America/Fortaleza
